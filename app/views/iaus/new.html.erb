<h1>IAU Auto-Fill</h1>

<hr>

<!-- ========================================================= -->
<!-- STEP 1 : SOURCE DOCUMENT -->
<!-- ========================================================= -->

<h2>Step 1 - Source Document</h2>

<div>
  <label for="source_text">
    <strong>Paste Patient Document</strong>
  </label>
</div>

<br>

<textarea
  id="source_text"
  rows="12"
  style="width:100%;"
  placeholder="Paste discharge summary, diagnosis report, prescription, clinical notes etc."
></textarea>

<br><br>

<button
  type="button"
  id="extract_button"
  onclick="extractWithAI()">
  Extract With AI
</button>

<div
  id="extract_status"
  style="margin-top:15px; font-weight:bold;">
</div>

<hr>

<!-- ========================================================= -->
<!-- STEP 2 : IAU FORM -->
<!-- ========================================================= -->

<h2>Step 2 - IAU Form</h2>

<%= form_for [@patient, @iau] do |f| %>

  <table
    width="100%"
    border="1"
    cellpadding="8"
    cellspacing="0"
    style="border-collapse:collapse;">

    <!-- Taken By -->
    <tr>
      <td width="250">
        <label>Taken By</label>
      </td>

      <td>
        <%= f.text_field :taken_by,
              id: "iau_taken_by",
              style: "width:300px;" %>
      </td>
    </tr>


    <!-- Given By -->
    <tr>
      <td>
        <label>Given By</label>
      </td>

      <td>
        <%= f.text_field :given_by,
              id: "iau_given_by",
              style: "width:300px;" %>
      </td>
    </tr>


    <!-- Relationship -->
    <tr>
      <td>
        <label>Relationship with Patient</label>
      </td>

      <td>
        <%= f.text_field :relation_with_patient,
              id: "iau_relation_with_patient",
              style: "width:300px;" %>
      </td>
    </tr>


    <!-- ===================================================== -->
    <!-- VITALS -->
    <!-- ===================================================== -->

    <tr>
      <td colspan="2">
        <strong>Vitals</strong>
      </td>
    </tr>


    <!-- BP Systolic -->
    <tr>
      <td>
        <label>BP Systolic</label>
      </td>

      <td>
        <%= f.text_field :vitals_bp_systolic,
              id: "iau_vitals_bp_systolic",
              style: "width:200px;" %>
      </td>
    </tr>


    <!-- BP Diastolic -->
    <tr>
      <td>
        <label>BP Diastolic</label>
      </td>

      <td>
        <%= f.text_field :vitals_bp_diastolic,
              id: "iau_vitals_bp_diastolic",
              style: "width:200px;" %>
      </td>
    </tr>


    <!-- Pulse -->
    <tr>
      <td>
        <label>Pulse</label>
      </td>

      <td>
        <%= f.text_field :vitals_pulse,
              id: "iau_vitals_pulse",
              style: "width:200px;" %>
      </td>
    </tr>


    <!-- Respiratory Rate -->
    <tr>
      <td>
        <label>Respiratory Rate</label>
      </td>

      <td>
        <%= f.text_field :vitals_respiratory_rate,
              id: "iau_vitals_respiratory_rate",
              style: "width:200px;" %>
      </td>
    </tr>


    <!-- Temperature -->
    <tr>
      <td>
        <label>Temperature</label>
      </td>

      <td>
        <%= f.text_field :vitals_temperature,
              id: "iau_vitals_temperature",
              style: "width:200px;" %>
      </td>
    </tr>


    <!-- SpO2 -->
    <tr>
      <td>
        <label>SpO2</label>
      </td>

      <td>
        <%= f.text_field :vitals_spo2,
              id: "iau_vitals_spo2",
              style: "width:200px;" %>
      </td>
    </tr>


    <!-- Pain Score -->
    <tr>
      <td>
        <label>Pain Score</label>
      </td>

      <td>
        <%= f.text_field :vitals_pain_score,
              id: "iau_vitals_pain_score",
              style: "width:200px;" %>
      </td>
    </tr>


    <!-- ===================================================== -->
    <!-- GENERAL EXAMINATION -->
    <!-- ===================================================== -->

    <tr>
      <td colspan="2">
        <strong>General Examination</strong>
      </td>
    </tr>


    <!-- Pallor -->
    <tr>
      <td>
        <label>Pallor</label>
      </td>

      <td>
        <%= f.check_box :pallor,
              id: "iau_pallor" %>

        <span id="iau_pallor_ai"></span>
      </td>
    </tr>


    <!-- Icterus -->
    <tr>
      <td>
        <label>Icterus</label>
      </td>

      <td>
        <%= f.check_box :icterus,
              id: "iau_icterus" %>

        <span id="iau_icterus_ai"></span>
      </td>
    </tr>


    <!-- Pedal Edema -->
    <tr>
      <td>
        <label>Pedal Edema</label>
      </td>

      <td>
        <%= f.check_box :pedal_edema,
              id: "iau_pedal_edema" %>

        <span id="iau_pedal_edema_ai"></span>
      </td>
    </tr>


    <!-- ===================================================== -->
    <!-- DIAGNOSIS -->
    <!-- ===================================================== -->

    <tr>
      <td>
        <label>Diagnosis</label>
      </td>

      <td>
        <%= f.text_area :diagnosis,
              id: "iau_diagnosis",
              rows: 5,
              style: "width:90%;" %>
      </td>
    </tr>


    <!-- ===================================================== -->
    <!-- CHIEF COMPLAINTS -->
    <!-- ===================================================== -->

    <tr>
      <td>
        <label>Chief Complaints</label>
      </td>

      <td>
        <%= f.text_area :chief_complaints,
              id: "iau_chief_complaints",
              rows: 5,
              style: "width:90%;" %>
      </td>
    </tr>

  </table>

  <br>

  <%= f.submit "Save IAU Form",
        style: "padding:10px 25px; cursor:pointer;" %>

<% end %>


<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>
function extractWithAI() {

  var sourceText = document.getElementById("source_text").value;

  if (!sourceText.trim()) {
    alert("Please enter patient document text.");
    return;
  }

  var status = document.getElementById("extract_status");

  status.innerHTML = "Extracting information from patient document...";

  fetch("/patients/<%= @patient.id %>/iaus/extract", {
    method: "POST",

    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector(
        'meta[name="csrf-token"]'
      ).content
    },

    body: JSON.stringify({
      source_text: sourceText
    })
  })

  .then(function(response) {

    if (!response.ok) {
      return response.json().then(function(errorData) {
        throw new Error(
          errorData.error || "AI extraction failed"
        );
      });
    }

    return response.json();
  })

  .then(function(response) {

    console.log("FULL AI RESPONSE:", response);

    if (!response.success) {
      throw new Error(
        response.error || "AI extraction failed"
      );
    }

    /*
     * IMPORTANT
     *
     * Controller is returning:
     *
     * {
     *   success: true,
     *   data: {
     *     taken_by: "...",
     *     given_by: "...",
     *     ...
     *   }
     * }
     *
     * Therefore actual fields are inside response.data
     */

    var data = response.data || {};

    console.log("EXTRACTED DATA:", data);


    // ==========================================
    // TAKEN BY
    // ==========================================

    fillField(
      "iau_taken_by",
      data.taken_by
    );


    // ==========================================
    // GIVEN BY
    // ==========================================

    fillField(
      "iau_given_by",
      data.given_by
    );


    // ==========================================
    // RELATIONSHIP WITH PATIENT
    // ==========================================

    fillField(
      "iau_relation_with_patient",
      data.relation_with_patient
    );


    // ==========================================
    // VITALS
    // ==========================================

    fillField(
      "iau_vitals_bp_systolic",
      data.vitals_bp_systolic
    );

    fillField(
      "iau_vitals_bp_diastolic",
      data.vitals_bp_diastolic
    );

    fillField(
      "iau_vitals_pulse",
      data.vitals_pulse
    );

    fillField(
      "iau_vitals_respiratory_rate",
      data.vitals_respiratory_rate
    );

    fillField(
      "iau_vitals_temperature",
      data.vitals_temperature
    );

    fillField(
      "iau_vitals_spo2",
      data.vitals_spo2
    );

    fillField(
      "iau_vitals_pain_score",
      data.vitals_pain_score
    );


    // ==========================================
    // GENERAL EXAMINATION
    // ==========================================

    setCheckbox(
      "iau_pallor",
      data.pallor
    );

    setCheckbox(
      "iau_icterus",
      data.icterus
    );

    setCheckbox(
      "iau_pedal_edema",
      data.pedal_edema
    );


    // ==========================================
    // DIAGNOSIS
    // ==========================================

    fillField(
      "iau_diagnosis",
      data.diagnosis
    );


    // ==========================================
    // CHIEF COMPLAINTS
    // ==========================================

    fillField(
      "iau_chief_complaints",
      data.chief_complaints
    );


    status.innerHTML =
      "AI extraction completed. Please review all highlighted fields before saving.";

    status.style.color = "green";


    // Highlight AI-filled fields

    highlightField("iau_taken_by");
    highlightField("iau_given_by");
    highlightField("iau_relation_with_patient");

    highlightField("iau_vitals_bp_systolic");
    highlightField("iau_vitals_bp_diastolic");
    highlightField("iau_vitals_pulse");
    highlightField("iau_vitals_respiratory_rate");
    highlightField("iau_vitals_temperature");
    highlightField("iau_vitals_spo2");
    highlightField("iau_vitals_pain_score");

    highlightField("iau_pallor");
    highlightField("iau_icterus");
    highlightField("iau_pedal_edema");

    highlightField("iau_diagnosis");
    highlightField("iau_chief_complaints");

  })

  .catch(function(error) {

    console.error("EXTRACTION ERROR:", error);

    status.innerHTML =
      "Extraction failed: " + error.message;

    status.style.color = "red";

  });
}


/*
 * ==========================================
 * FILL TEXT FIELD
 * ==========================================
 */

function fillField(id, value) {

  var element = document.getElementById(id);

  if (!element) {
    console.warn("Field not found:", id);
    return;
  }

  if (
    value !== null &&
    value !== undefined &&
    String(value).trim() !== ""
  ) {

    element.value = value;

    element.style.backgroundColor = "#fff8b3";
  }
}


/*
 * ==========================================
 * CHECKBOX
 * ==========================================
 */

function setCheckbox(id, value) {

  var element = document.getElementById(id);

  if (!element) {
    console.warn("Checkbox not found:", id);
    return;
  }

  if (
    value === true ||
    value === "true" ||
    value === "True" ||
    value === 1 ||
    value === "1"
  ) {

    element.checked = true;

  } else if (
    value === false ||
    value === "false" ||
    value === "False" ||
    value === 0 ||
    value === "0"
  ) {

    element.checked = false;
  }

}


/*
 * ==========================================
 * HIGHLIGHT AI FILLED FIELD
 * ==========================================
 */

function highlightField(id) {

  var element = document.getElementById(id);

  if (!element) {
    return;
  }

  if (
    element.value !== undefined &&
    String(element.value).trim() !== ""
  ) {

    element.style.backgroundColor = "#fff8b3";
    element.style.border = "2px solid #e0b400";
  }

}
</script>